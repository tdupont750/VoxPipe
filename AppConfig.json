{
  "outputs": ["Console", "ydotool"],
  "captureTimeoutSeconds": 60,
  "deviceIndex": -1,
  "deviceName": "C922 Pro",
  "language": "en",
  "modelDir": "~/git/hub/PvWhisper/WhisperModels",
  "modelType": "Base",
  "httpPort": 5042,
  "whisperThreads": 8,
  "frameLength": 512,
  "textTransforms": [{
    "description": "Capitalize first letter",
    "find": "^(\\w)",
    "replace": "{1:ToUpper}",
    "caseSensitive": false,
    "isRegex": true
  }, {
    "description": "Add space at start of sentence",
    "find": "^Space\\s(\\w)",
    "replace": " {1:ToUpper}",
    "caseSensitive": false,
    "isRegex": true
  }, {
    "description": "Replace backspace with ydotool token",
    "find": "^Back\\s?space\\S?\\s",
    "replace": "{ydotool:KEY_BACKSPACE} ",
    "caseSensitive": false,
    "isRegex": true
  }, {
    "description": "Remove whisper noise messages",
    "find": "\\[(\\w|_)+\\]",
    "replace": "",
    "caseSensitive": false,
    "isRegex": true
  }, {
    "description": "clawed",
    "find": "\\b(clawed)\\b",
    "replace": "Claude",
    "caseSensitive": false,
    "isRegex": true
  }, {
    "description": "cloud md",
    "find": "\\b(cloud md)\\b",
    "replace": "Claude.MD",
    "caseSensitive": false,
    "isRegex": true
  }, {
    "description": "Gira",
    "find": "\\b(gira)\\b",
    "replace": "Jira",
    "caseSensitive": false,
    "isRegex": true
  }, {
    "description": "Balor",
    "find": "\\b(baller)|(bellar)\\b",
    "replace": "Balor",
    "caseSensitive": false,
    "isRegex": true
  }, {
    "description": "Airtable",
    "find": "\\b(air\\s?table)\\b",
    "replace": "Airtable",
    "caseSensitive": false,
    "isRegex": true
  }, {
    "description": "1Password",
    "find": "\\b(one password)\\b",
    "replace": "1Password",
    "caseSensitive": false,
    "isRegex": true
  }, {
    "description": "sync",
    "find": "\\bsink\\b",
    "replace": "sync",
    "caseSensitive": false,
    "isRegex": true
  }, {
    "description": "Survios",
    "find": "\\bServios\\b",
    "replace": "Survios",
    "caseSensitive": false,
    "isRegex": true
  }, {
    "description": "Shawna",
    "find": "\\bShana\\b",
    "replace": "Shawna",
    "caseSensitive": false,
    "isRegex": true
  }, {
    "description": "Destinee",
    "find": "\\bDestiny\\b",
    "replace": "Destinee",
    "caseSensitive": false,
    "isRegex": true
  }]
}
